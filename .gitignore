# ==============================================================================
# Nestora — Monorepo Git Ignore Rules
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Package management and dependencies
node_modules/
.pnpm-store
.npm
.yarn/
.pnp.*

# Build and compilation outputs
.next/
dist/
build/
out/
.tsbuildinfo
*.tsbuildinfo

# Turborepo execution cache
.turbo/

# Environment configuration (secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local
!.env.example

# Diagnostic and execution logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Unit and integration test coverage
coverage/
.nyc_output/

# IDE and developer tooling
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Runtime file uploads and temporary caches (not apps/api/src/modules/uploads)
/uploads/
apps/api/uploads/

# Docker local volumes (when bind-mounting)
docker/data/
tmp/
temp/

.agents/
.cursor/

# Local Neon / agent tooling (not part of the app)
.neon
.neon/
neon.ts
skills-lock.json
