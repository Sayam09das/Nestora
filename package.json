{
  "name": "nestora",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @nestora/web dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "db:generate": "pnpm --filter @nestora/database db:generate",
    "db:migrate:dev": "pnpm --filter @nestora/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @nestora/database db:migrate:deploy",
    "db:seed": "pnpm --filter @nestora/database db:seed",
    "db:validate": "pnpm --filter @nestora/database db:validate",
    "neon:storage-smoke": "node --env-file=apps/api/.env scripts/neon-object-storage-smoke.mjs",
    "neon:list-student-buckets": "node scripts/list-student-buckets.mjs",
    "neon:e2e-student": "node scripts/e2e-student-neon-upload.mjs",
    "neon:verify-setup": "node scripts/verify-neon-storage-setup.mjs",
    "neon:merge-api-env": "node scripts/merge-neon-storage-into-api-env.mjs",
    "neon:seed-student": "pnpm --filter @nestora/api seed:neon-student",
    "neon:seed-staff": "pnpm --filter @nestora/api seed:neon-staff",
    "neon:seed-rooms": "pnpm --filter @nestora/api seed:neon-rooms",
    "neon:seed-students-roster": "pnpm --filter @nestora/api seed:neon-students-roster",
    "neon:seed-students-allocate": "pnpm --filter @nestora/api seed:neon-students-allocate",
    "neon:seed-workforce-roster": "pnpm --filter @nestora/api seed:neon-workforce-roster",
    "neon:seed-finance": "pnpm --filter @nestora/api seed:neon-finance",
    "neon:seed-complaints": "pnpm --filter @nestora/api seed:neon-complaints",
    "neon:seed-leave": "pnpm --filter @nestora/api seed:neon-leave",
    "neon:seed-announcements": "pnpm --filter @nestora/api seed:neon-announcements",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@aws-sdk/s3-presigned-post": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@biomejs/biome": "^2.6.6",
    "files-sdk": "^3.1.2",
    "turbo": "^2.5.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0"
  }
}
