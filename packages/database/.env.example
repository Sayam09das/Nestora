# First admin (production): pnpm --filter @nestora/database admin:init -- --email you@university.edu
# Requires WEB_URL for the printed activation link.
WEB_URL=http://localhost:3000

# Local Docker (pnpm docker:up):
DATABASE_URL=postgresql://nestora:nestora_dev_pw@localhost:5432/nestora_db?schema=public
DIRECT_DATABASE_URL=postgresql://nestora:nestora_dev_pw@localhost:5432/nestora_db?schema=public

# Neon (recommended for apps/api at runtime):
# DATABASE_URL = **pooled** host (-pooler) with pgbouncer (added automatically if missing):
#   postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
# DIRECT_DATABASE_URL = **direct** host (migrations / Prisma CLI only):
#   postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Do not use channel_binding=require — it breaks Prisma on many setups.

# Apply schema: pnpm --filter @nestora/database db:migrate:deploy
