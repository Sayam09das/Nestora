# Local Docker (pnpm docker:up):
DATABASE_URL=postgresql://nestora:nestora_dev_pw@localhost:5432/nestora_db?schema=public
DIRECT_DATABASE_URL=postgresql://nestora:nestora_dev_pw@localhost:5432/nestora_db?schema=public

# Neon: paste the **direct** connection string (host without "-pooler") for both lines below.
# Do not use channel_binding=require — it breaks Prisma on many setups.
# DATABASE_URL=postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# DIRECT_DATABASE_URL=postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_POOLED=postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Apply schema: pnpm --filter @nestora/database db:migrate:deploy
