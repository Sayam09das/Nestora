# Direct connection (required for Prisma migrate). Local Docker:
DATABASE_URL=postgresql://nestora:nestora_dev_pw@localhost:5432/nestora_db?schema=public

# Optional: Neon pooler URL for app runtime (do not use for migrations)
# DATABASE_URL_POOLED=postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Neon: use the non-pooler host for DATABASE_URL; enable the project in the Neon console if connections fail (P1001).
