{
  "name": "@nestora/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma ORM and PostgreSQL data layer for Nestora",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/deploy-migration.mjs",
    "db:migrate:neon-http": "node scripts/deploy-neon-http.mjs",
    "db:validate": "prisma validate",
    "db:seed": "tsx prisma/seed/seed.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.build.json --noEmit",
    "lint": "biome check src prisma/seed/seed.ts",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "@nestora/config": "workspace:*",
    "@types/node": "^26.6.6",
    "prisma": "^7.10.1",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  }
}
