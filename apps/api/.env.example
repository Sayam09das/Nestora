# Runtime & network
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Public API URL (required in production when web and API are on different hosts, e.g. Render + Vercel)
# API_URL=https://nestora-api.onrender.com
CORS_ORIGIN=http://localhost:3000
# Optional: force cookie SameSite when auto-detection is wrong (split deploy usually needs `none`)
# COOKIE_SAME_SITE=none
# Optional comma-separated extra browser origins for credentialed CORS
# CORS_ORIGINS=http://localhost:3001
# Requests per IP per minute (defaults to 100)
RATE_LIMIT_MAX=100

# Database (used when Prisma is enabled — start Postgres via docker/docker-compose.yml)
DATABASE_URL=postgresql://nestora:nestora_dev_pw@localhost:5432/nestora_db?schema=public&connection_limit=10

# Security (replace before any shared environment)
COOKIE_SECRET=change_me_to_a_32_byte_secure_random_string
SESSION_TTL_HOURS=24
# Development defaults to 480 min (8 h) when unset. Production default: 30.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Argon2id (memory in KiB; tune per server)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# MFA secret encryption — prefer a dedicated 32+ char secret in production
# MFA_ENCRYPTION_SECRET=

# When true, UNIVERSITY_ADMINISTRATOR and ACCOUNTANT must enroll MFA before most APIs
PRIVILEGED_MFA_ENFORCED=false

# SMTP (Brevo / custom provider, or MailHog localhost:1025 for local dev)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@smtp-brevo.com
SMTP_PASS=your_brevo_smtp_key_here
SMTP_FROM="Nestora <no-reply@nestora.university.edu>"

# Brevo specific references
BREVO_API_KEY=your_brevo_api_key_here
BREVO_USER=your_brevo_login@smtp-brevo.com
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_EMAIL=no-reply@nestora.university.edu

# ==============================================================================
# Neon Object Storage (student photos + documents) — NOT Amazon AWS
# ==============================================================================
# 1) npx neon login && npx neon link --project-id <id> --branch production
# 2) npx neon deploy && npx neon env pull
# 3) Paste the lines below from the pulled file into this .env
#
STORAGE_DRIVER=neon
S3_BUCKET_PUBLIC=nestora-student-profiles
S3_BUCKET_PRIVATE=nestora-student-documents
S3_BUCKET_STAFF_PUBLIC=nestora-staff-profiles
S3_BUCKET_STAFF_PRIVATE=nestora-staff-documents
# Neon uses AWS-standard names for the S3-compatible API (branch-scoped credentials):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
#
# Optional local-only fallback (no Neon):
# STORAGE_DRIVER=local
# UPLOAD_LOCAL_PATH=./uploads

S3_BUCKET_NAME=nestora-attachments
MAX_UPLOAD_SIZE_BYTES=5242880
STUDENT_PHOTO_MAX_BYTES=2097152
