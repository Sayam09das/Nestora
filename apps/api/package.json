{
  "name": "@nestora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:neon-student": "node --env-file=.env --import tsx/esm scripts/seed-neon-student-with-uploads.ts",
    "seed:neon-staff": "node --env-file=.env --import tsx/esm scripts/seed-neon-staff-with-uploads.ts",
    "seed:neon-rooms": "node --env-file=.env --import tsx/esm scripts/seed-neon-rooms-and-beds.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@nestora/database": "workspace:*",
    "@nestora/types": "workspace:*",
    "@nestora/validators": "workspace:*",
    "argon2": "^0.44.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "nodemailer": "^7.0.9",
    "otplib": "^13.1.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@nestora/config": "workspace:*",
    "@types/nodemailer": "^7.0.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.0.7"
  }
}
